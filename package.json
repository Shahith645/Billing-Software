{
  "name": "ss-software",
  "version": "2.0.2",
  "description": "Supermarket Billing Software",
  "main": "main.js",
  "author": "Shahith S",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.freshmart.billing",
    "productName": "Billing Software",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "license.js",
      "package.json",
      "node_modules/**"
    ]
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0"
  }
}
